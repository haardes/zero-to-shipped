{
  "enabled": true,
  "name": "TypeScript Documentation Checker",
  "description": "Checks if saved TypeScript files contain usage documentation with examples. If missing, adds JSDoc-style documentation to the top of the file.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if the edited TypeScript file contains usage documentation with examples. If the file is missing proper JSDoc documentation at the top with usage examples, add comprehensive JSDoc-style documentation including: description, usage examples, parameter descriptions, and return type information. Follow TypeScript best practices for documentation."
  }
}